# StoryForge 生产环境变量示例（复制为 .env 后填写，不要提交真实密钥）

# 必填：JWT 签名密钥（建议 ≥32 字符）
JWT_SECRET=please-change-to-a-long-random-secret

# 对外映射端口
HOST_PORT=3000

# 是否给 Cookie 加 Secure（仅 HTTPS 时设 true；用 http://IP 访问时保持 false）
COOKIE_SECURE=false

# 可选：管理员用户 ID（逗号分隔）。不配置时，用户名 nastume 仍可作为测试管理员。
# STORYFORGE_ADMIN_USER_IDS=

# 可选：国内服务器访问外网 API 时的代理
# HTTPS_PROXY=
# HTTP_PROXY=

# 可选：对话（DeepSeek，平台统一密钥，用户不配置）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 可选：配图 / 配视频（硅基流动，平台统一密钥）
# 生产环境必须取消注释并填写，否则配图/配视频会提示「媒体服务暂不可用」
# 申请 Key：https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
# SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
# SILICONFLOW_VIDEO_I2V_MODEL=Wan-AI/Wan2.2-I2V-A14B
